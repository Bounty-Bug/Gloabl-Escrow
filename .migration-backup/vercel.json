{
  "version": 2,
  "buildCommand": "pnpm install --frozen-lockfile && BASE_PATH=/ pnpm --filter @workspace/escrow-app run build",
  "outputDirectory": "artifacts/escrow-app/dist/public",
  "framework": null,
  "functions": {
    "api/server.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
